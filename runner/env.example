# pipensx-catalog VPS Runner environment
# Copy this file to .env on your VPS: cp env.example .env

# GitHub repository (owner/repo)
GITHUB_REPO=i3sey/pipensx-catalog

# GitHub Personal Access Token (classic PAT with "repo" scope, or fine-grained with "Contents: Read and write")
# Required to publish GitHub releases.
GITHUB_TOKEN=

# RuTracker session cookies (from your browser DevTools / Cookie-Editor on rutracker.org)
# Needs bb_data and bb_session for viewtorrent.php access
RUTRACKER_COOKIE=bb_data=...; bb_session=...; bb_ssl=1

# Optional HTTP/SOCKS proxy (e.g. http://proxy:port or socks5://127.0.0.1:1080)
# SCRAPER_PROXY=

# Scraper knobs
PAGES=3
DELAY=1.5

# Force publish: set to 1 to force creating a new GitHub release even if catalog SHA-256 did not change
FORCE_PUBLISH=0
