# Copy to .env and fill in. The runner reads this file (--env-file).
# MODE=run|probe — probe only prints the transport matrix, publishes nothing.

# GitHub repo + token (classic PAT with `repo` scope, or fine-grained with
# Contents:read/write). Required only for publishing; scraping works without.
GITHUB_REPO=i3sey/pipensx-catalog
GITHUB_TOKEN=

# RuTracker session, full Cookie header value WITHOUT the "Cookie:" prefix:
# bb_guid=...; bb_t=...; bb_session=...; bb_ssl=1 (+ cf_clearance=... when the
# home browser passed the challenge — export via Cookie-Editor).
# Empty = anonymous attempt (expect a Cloudflare challenge → clean fallback).
RUTRACKER_COOKIE=

# Optional proxy for scraper traffic only, e.g. socks5h://127.0.0.1:1080.
# Empty = direct.
SCRAPER_PROXY=

# Thrift knobs: topics per tick and delay between requests.
TOPICS_WINDOW=60
SCRAPE_DELAY=3
SCRAPE_TIMEOUT=30
# TOPICS=6892780,6877101   # explicit list overrides the rotation window
# FORCE_PUBLISH=1          # publish even when the manifest sha is unchanged
